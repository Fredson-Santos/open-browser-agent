{
  "manifest_version": 3,
  "name": "OBA — Open Browser Agent",
  "version": "0.4.0",
  "description": "Permite que qualquer agente de IA (via MCP) controle o navegador.",
  "minimum_chrome_version": "116",
  "key": "",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "OBA — abrir painel"
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "tabGroups",
    "debugger",
    "storage",
    "alarms",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
